            "А123ВС77"
          ],
          "title": "Plate",
          "type": "string"
        },
        "direction": {
          "$ref": "#/$defs/Direction"
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
