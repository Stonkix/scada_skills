{
  "title": "Event",
  "$defs": {
    "AccessControlEvent": {
      "additionalProperties": false,
      "properties": {
        "event_id": {
          "description": "Ключ идемпотентности",
          "format": "uuid",
          "title": "Event Id",
          "type": "string"
        },
        "schema_v": {
          "const": 1,
          "default": 1,
          "title": "Schema V",
          "type": "integer"
        },
        "sensor_id": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Sensor Id",
          "type": "string"
        },
        "ts": {
          "description": "Время измерения на датчике; агрегаты считаются по нему",
          "format": "date-time",
          "title": "Ts",
          "type": "string"
        },
        "received_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Время приёма коннектором; ставит коннектор",
          "title": "Received At"
        },
        "geo": {
          "anyOf": [
            {
              "$ref": "#/$defs/Geo"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "zone_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Зона плана; ставит датчик (СКУД) или worker (point-in-polygon)",
          "title": "Zone Id"
        },
        "type": {
          "const": "access_control",
          "title": "Type",
          "type": "string"
        },
        "payload": {
          "$ref": "#/$defs/AccessControlPayload"
        }
      },
      "required": [
        "sensor_id",
        "ts",
        "type",
        "payload"
      ],
      "title": "AccessControlEvent",
      "type": "object"
    },
    "AccessControlPayload": {
      "additionalProperties": false,
      "properties": {
        "card_id": {
          "examples": [
            "P-000123"
          ],
          "title": "Card Id",
          "type": "string"
        },
        "direction": {
          "$ref": "#/$defs/Direction"
        },
        "granted": {
          "description": "Решение контроллера СКУД",
          "title": "Granted",
          "type": "boolean"
        }
      },
      "required": [
        "card_id",
        "direction",
        "granted"
      ],
      "title": "AccessControlPayload",
      "type": "object"
    },
