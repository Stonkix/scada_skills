    "Direction": {
      "enum": [
        "in",
        "out"
      ],
      "title": "Direction",
      "type": "string"
    },
    "Geo": {
      "additionalProperties": false,
      "description": "Point in local plan coordinates, metres from the site origin (south-west corner).",
      "properties": {
        "x": {
          "title": "X",
          "type": "number"
        },
        "y": {
          "title": "Y",
          "type": "number"
        },
        "floor": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Этаж внутри здания; null — улица",
          "title": "Floor"
        }
      },
      "required": [
        "x",
        "y"
      ],
      "title": "Geo",
      "type": "object"
    },
